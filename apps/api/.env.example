# Local API: copy to `.env` next to this file:
#   cp .env.example .env
#
# Loaded automatically when you run `yarn workspace @app/api dev` (see `src/config/dotenv-and-defaults.ts`).
# Docker Compose does not use this file; it sets env in `docker-compose.yml`.

# --- Required (Postgres) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/brimble_fullstack

# --- Optional ---
# PORT=3000
# CADDY_ADMIN_URL=http://127.0.0.1:2019
# CADDY_HTTP_SERVER_ID=srv0
# DOCKER_NETWORK=b-fullstack_default
# BUILDKIT_HOST=docker-container://buildkit
# RAILPACK_BUILD_CMD=yarn workspace @app/sample-app build
# RAILPACK_START_CMD=yarn workspace @app/sample-app start
# FORCE_PIPELINE_FAIL=0

# SAMPLE_APP_SOURCE_PATH defaults to the monorepo root (where `yarn.lock` lives).
# UPLOAD_WORKSPACE_ROOT defaults to `apps/api/.data/b-fullstack-uploads/`.
