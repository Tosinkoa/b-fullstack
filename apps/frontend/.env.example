# Local Vite dev: copy to `.env` in this folder (`apps/frontend/`):
#   cp .env.example .env
#
# Defaults: dev server proxies /api → http://127.0.0.1:3000.
# `vite preview` uses `PREVIEW_PROXY_TARGET` (set in docker-compose for containers).

# VITE_API_BASE_URL=/api
# DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# PREVIEW_PROXY_TARGET=http://api:3000
